digraph HuffmanTree {
  node [fontname=Helvetica];
  n0 [shape=box,label="a\nfreq=5"];
  n1 [shape=box,label="b\nfreq=2"];
  n2 [shape=box,label="c\nfreq=1"];
  n3 [shape=box,label="d\nfreq=1"];
  n4 [shape=box,label="r\nfreq=2"];
  n5 [label="freq=2"];
  n5 -> n2 [label="0"];
  n5 -> n3 [label="1"];
  n6 [label="freq=4"];
  n6 -> n1 [label="0"];
  n6 -> n4 [label="1"];
  n7 [label="freq=6"];
  n7 -> n5 [label="0"];
  n7 -> n6 [label="1"];
  n8 [label="freq=11"];
  n8 -> n0 [label="0"];
  n8 -> n7 [label="1"];
}
